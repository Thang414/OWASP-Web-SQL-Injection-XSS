# ==============================================================================
# TỆP CẤU HÌNH MẪU MÔI TRƯỜNG LAB (ENVIRONMENT VARIABLES TEMPLATE)
# Đề tài: Khai thác lỗ hổng Web OWASP (SQLi & XSS) - UTH
# Mã công việc: CORE-02 (ANM-18) - Phụ trách: TV3 (Ngọc Thắng)
# ==============================================================================
# Hướng dẫn: Sao chép tệp này thành .env hoặc thiết lập trực tiếp biến môi trường
# trên hệ điều hành trước khi khởi chạy ứng dụng Spring Boot.

# ------------------------------------------------------------------------------
# 1. Cấu hình ứng dụng chứa lỗ hổng (Vulnerable App - Mặc định cổng 8080)
# ------------------------------------------------------------------------------
SERVER_PORT_VULN=8080

# ------------------------------------------------------------------------------
# 2. Cấu hình ứng dụng đã vá bảo mật (Secured App - Mặc định cổng 8081)
# ------------------------------------------------------------------------------
SERVER_PORT_SECURED=8081

# ------------------------------------------------------------------------------
# 3. Cấu hình kết nối cơ sở dữ liệu MariaDB / MySQL
# ------------------------------------------------------------------------------
# Khi chạy qua Docker Compose: DB_HOST=db
# Khi chạy Maven cục bộ trên máy host: DB_HOST=localhost (hoặc để trống để dùng H2 fallback)
DB_HOST=db
DB_PORT=3306
DB_NAME=ecommerce_db
DB_USER=db_user
DB_PASS=P@ssword123

# Mật khẩu quản trị viên CSDL (dùng cho container MariaDB)
MYSQL_ROOT_PASSWORD=root_secure_pass_123

# ------------------------------------------------------------------------------
# 4. Cấu hình máy chủ hứng Cookie (Cookie Stealer Listener - Cổng 8888)
# ------------------------------------------------------------------------------
COOKIE_STEALER_PORT=8888
